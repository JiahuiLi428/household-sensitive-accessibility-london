# Local archive and temporary files
/cache/
/tmp/
**/__pycache__/
*.py[cod]
~$*
~WRL*.tmp
.DS_Store
Thumbs.db

# R/RStudio session state
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Generated R5 build caches
data/r5/**/*.mapdb
data/r5/**/*.mapdb.p
data/r5/**/network.dat
data/r5/**/r5r-log.log
data/r5/**/gtfs_errors.csv
